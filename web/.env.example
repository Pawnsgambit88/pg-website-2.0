# Pawn's Gambit web. Copy to .env.local for local work. No real secrets in this file.
# Only NEXT_PUBLIC_* values reach the browser. Names matching SECRET|TOKEN|KEY|PASSWORD must never start with NEXT_PUBLIC_.

# ---- Public (build-time constants, inlined by Next) ----
# Mocks: true only locally and on an explicit preview opt-in. A production build with true fails (scripts/guard-env.ts).
NEXT_PUBLIC_USE_MOCKS=false
# Same-origin API prefix (relative).
NEXT_PUBLIC_API_BASE_URL=/api
# Absolute site origin: canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Feature flags: 'true' enables, anything else disables.
# Session transport for a real backend; must equal the backend AUTH_TOKEN_MODE (body or cookie). Mocks always use body.
NEXT_PUBLIC_AUTH_MODE=cookie
NEXT_PUBLIC_GOOGLE_AUTH=false
NEXT_PUBLIC_RAZORPAY_ENABLED=false
# 'form' or 'off'.
NEXT_PUBLIC_CONTACT_MODE=form
# Image host and URL composition (config, not secrets). Leave empty in mock mode.
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=
NEXT_PUBLIC_MEDIA_BASE_URL=
NEXT_PUBLIC_MEDIA_BUCKET=pg-media

# ---- Server only (never exposed to the browser) ----
# Railway API origin. Required when NEXT_PUBLIC_USE_MOCKS is not 'true'.
API_INTERNAL_URL=
# Shared HMAC secret for /api/revalidate, at least 32 random bytes. Required when mocks are off.
REVALIDATE_SECRET=6df17083e26192b3210043b006602ca68a71457199e08894cd24adf58e442076
# Optional previous secret accepted during rotation.
REVALIDATE_SECRET_PREVIOUS=
# Authenticates the draft-preview token exchange with the backend.
PREVIEW_SECRET=
