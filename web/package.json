{
  "name": "pg-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pawn's Gambit web frontend (Next.js App Router). Independent package, not a root workspace member.",
  "engines": {
    "node": ">=22.12 <25"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "iOS >= 16.4",
    "ChromeAndroid >= 111"
  ],
  "scripts": {
    "dev": "next dev",
    "guard:env": "node scripts/guard-env.ts",
    "build": "npm run guard:env && next build && npm run check:build-output",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-module-directives.ts",
    "check:build-output": "node scripts/check-build-output.ts",
    "check:tokens": "node scripts/check-tokens.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:deps && npm run test && npm run check:tokens",
    "analyze": "node scripts/analyze.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@hookform/resolvers": "~6.0.0",
    "@radix-ui/react-checkbox": "~1.4.1",
    "@radix-ui/react-dialog": "~1.3.1",
    "@radix-ui/react-select": "~2.4.1",
    "@radix-ui/react-switch": "~1.4.1",
    "@radix-ui/react-tabs": "~1.2.1",
    "@tanstack/react-query": "~5.104.5",
    "gsap": "3.15.0",
    "next": "~16.4.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-hook-form": "~7.90.0",
    "server-only": "^0.0.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@next/bundle-analyzer": "~16.4.2",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/postcss": "~4.3.3",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "dependency-cruiser": "~18.7.0",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.2",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "jsdom": "~29.1.1",
    "prettier": "~3.9.10",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "tailwindcss": "~4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~8.3.5",
    "vitest": "~5.0.5",
    "vitest-axe": "~0.1.0"
  }
}
