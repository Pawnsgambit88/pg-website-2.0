# Local run against the real Django backend (mocks OFF). Copy to .env.local and fill REVALIDATE_SECRET. Never commit .env.local.
NEXT_PUBLIC_USE_MOCKS=false
# Same-origin prefix; the /api/* rewrite in next.config.ts forwards it to API_INTERNAL_URL. Must be a relative path.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Django origin (no trailing /api). Server-only; also the rewrite destination.
API_INTERNAL_URL=http://127.0.0.1:8000
# At least 32 random characters. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Backend side (backend/.env): AUTH_TOKEN_MODE=body, DEBUG=True (needed for seed_dev_accounts).
# CORS is not needed: the browser only talks to the website origin and the rewrite proxies to Django.
