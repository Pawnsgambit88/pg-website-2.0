{
  "version": "2.1",
  "colors": {
    "parchment": "#F4EFE6",
    "parchmentSoft": "#FBF8F2",
    "sand": "#E7DED0",
    "forest": "#243228",
    "forestDark": "#17231C",
    "ink": "#171614",
    "copper": "#B86A3B",
    "copperDark": "#8F4E2D",
    "stone": "#B9AE9D",
    "muted": "#6C685F",
    "success": "#486A4F",
    "warning": "#9D7033",
    "danger": "#8D3C35"
  },
  "fonts": {
    "display": {"family": "Newsreader", "fallback": "Georgia, serif"},
    "ui": {"family": "Anek Latin", "fallback": "Arial Narrow, sans-serif"},
    "mono": {"family": "Fragment Mono", "fallback": "ui-monospace, monospace"}
  },
  "type": {
    "body": {"size": "17px", "lineHeight": 1.48},
    "hero": {"family": "display", "size": "clamp(3.4rem, 7.2vw, 7.5rem)", "weight": 430, "lineHeight": 0.92, "letterSpacing": "-0.045em"},
    "section": {"family": "display", "size": "clamp(2.4rem, 4.4vw, 5rem)", "weight": 430, "lineHeight": 0.92, "letterSpacing": "-0.045em"},
    "eyebrow": {"family": "mono", "size": "0.72rem", "lineHeight": 1.3, "letterSpacing": "0.12em", "transform": "uppercase"},
    "button": {"family": "mono", "size": "0.72rem", "letterSpacing": "0.06em", "transform": "uppercase"}
  },
  "spacingPx": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "layout": {
    "maxShell": "1440px",
    "desktopGutter": "36px",
    "mobileGutter": "20px",
    "playerSidebar": "248px",
    "adminSidebar": "264px",
    "controlHeight": "48px"
  },
  "radius": {"public": "2px", "operationalMax": "6px"},
  "breakpointsPx": [480, 720, 960, 1200, 1440],
  "motion": {
    "control": "180-240ms",
    "editorialReveal": "500-800ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "reducedMotion": "Disable non-essential transforms, autoplay and parallax"
  }
}
